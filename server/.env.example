PORT=4000
# Generá uno largo y aleatorio: openssl rand -hex 32
JWT_SECRET=cambiar_por_un_secreto_largo_y_unico

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?appName=<app>

# Cloudinary (para upload de imágenes)
# Conseguilo en: cloudinary.com → Settings → API Keys
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Opcional: token de producción o test de Mercado Pago (nunca lo subas al repo)
# https://www.mercadopago.com.ar/developers/panel/credentials
MERCADOPAGO_ACCESS_TOKEN=

# URL pública del front (HTTPS). Necesaria para que MP redirija tras el pago.
# En local usá ngrok: ngrok http 5173 → APP_URL=https://xxxx.ngrok-free.app
APP_URL=

# URLs de retorno después del pago (Checkout Pro). Deben ser HTTPS en producción.
# Si definís APP_URL, podés omitir estas tres (se arman solas).
MP_SUCCESS_URL=http://localhost:5173/?payment=success
MP_FAILURE_URL=http://localhost:5173/?payment=failure
MP_PENDING_URL=http://localhost:5173/?payment=pending

# ---------------------------------------------------------------------------
# Recordatorio de carritos abandonados (Resend + cron)
# ---------------------------------------------------------------------------

# API key de Resend (https://resend.com → API Keys). NUNCA subir al repo.
# Si falta, el envío se omite de forma segura y se registra en el log.
RESEND_API_KEY=

# Remitente. En pruebas usá onboarding@resend.dev; en producción, un correo
# del dominio verificado, por ejemplo: Bronza <hola@bronzaclub.com>
EMAIL_FROM=Bronza <onboarding@resend.dev>

# Opcional: responder a este correo cuando la clienta contesta.
EMAIL_REPLY_TO=

# Horas de inactividad para considerar el carrito abandonado (default 2).
ABANDONED_CART_HOURS=2

# Secreto que protege el endpoint de cron. Generá uno: openssl rand -hex 32
# Vercel Cron lo envía automáticamente como "Authorization: Bearer <valor>".
CRON_SECRET=
